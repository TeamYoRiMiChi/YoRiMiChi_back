<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.yorimichi.yorimichi.domain.mypage.repository.MyPageProfileMapper">

    <resultMap id="myPageProfileResultMap"
        type="com.yorimichi.yorimichi.domain.mypage.dto.MyPageProfileResponseDto">
        <result property="name" column="name"/>
        <result property="email" column="email"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>
    
    <select id="findByMemberId" resultMap="myPageProfileResultMap">
        SELECT name, email, created_at
        FROM MEMBER
        WHERE member_id = #{memberId}
    </select>	
</mapper>