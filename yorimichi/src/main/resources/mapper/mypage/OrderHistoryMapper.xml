<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yorimichi.yorimichi.domain.mypage.repository.OrderHistoryMapper">
	<resultMap id="orderHistoryResultMap"
           type="com.yorimichi.yorimichi.domain.mypage.entity.OrderHistory">

    	<id property="orderId" column="order_id"/>

    	<result property="orderNumber" column="order_number"/>
    	<result property="orderType" column="order_type"/>
    	<result property="totalAmount" column="total_amount"/>
    	<result property="orderStatus" column="order_status"/>
    	<result property="orderedAt" column="ordered_at"/>
	</resultMap>
	
	<resultMap id="orderItemResultMap"
    	type="com.yorimichi.yorimichi.domain.mypage.entity.OrderItem">

    	<id property="orderItemId" column="order_item_id"/>

    	<result property="orderId" column="order_id"/>
    	<result property="productId" column="product_id"/>
    	<result property="productName" column="product_name"/>
    	<result property="priceJpy" column="price_jpy"/>
    	<result property="priceKrw" column="price_krw"/>
    	<result property="quantity" column="quantity"/>
    	<result property="itemTotal" column="item_total"/>
    	<result property="createdAt" column="created_at"/>
    	<result property="updatedAt" column="updated_at"/>
	</resultMap>

    <select id="findOrderHistoriesByMemberId" resultMap="orderHistoryResultMap">
    	SELECT
        	order_id,
        	order_number,
        	order_type,
        	total_amount,
        	order_status,
        	ordered_at
    	FROM ORDERS
    	WHERE member_id = #{memberId}
    	ORDER BY order_id DESC
	</select>


	<select id="findItemsByOrderId" resultMap="orderItemResultMap">
    	SELECT
        	order_item_id,
        	order_id,
        	product_id,
        	product_name,
        	price_jpy,
        	price_krw,
        	quantity,
        	item_total,
        	created_at,
        	updated_at
    	FROM order_item
    	WHERE order_id = #{orderId}
    	ORDER BY order_item_id ASC
	</select>
</mapper>