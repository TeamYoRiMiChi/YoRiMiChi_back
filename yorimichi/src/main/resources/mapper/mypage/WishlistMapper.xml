<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.yorimichi.yorimichi.domain.mypage.repository.WishlistMapper">

    <resultMap id="wishlistResultMap" type="com.yorimichi.yorimichi.domain.mypage.entity.Wishlist">
        <id property="wishlistId" column="wishlist_id"/>
        <result property="memberId" column="member_id"/>
        <result property="productId" column="product_id"/>
        <result property="name" column="name"/>
        <result property="price" column="price"/>
        <result property="soldOut" column="sold_out"/>
        <result property="thumbnailUrl" column="thumbnail_url"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAllByMemberId" resultMap="wishlistResultMap">
        SELECT
            w.wishlist_id,
            w.member_id,
            w.product_id,
            COALESCE(p.product_name_jp, p.product_name) AS name,
            p.price_jpy AS price,
            CASE
                WHEN p.stock &lt;= 0 OR p.status = 'SOLD_OUT' THEN TRUE
                ELSE FALSE
            END AS sold_out,
            p.thumbnail_url,
            w.created_at,
            w.updated_at
        FROM WISHLIST w
        INNER JOIN PRODUCT p
            ON p.product_id = w.product_id
        WHERE w.member_id = #{memberId}
        ORDER BY w.created_at DESC
    </select>

</mapper>
