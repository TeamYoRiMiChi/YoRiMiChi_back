<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yorimichi.yorimichi.domain.mypage.repository.MyProfileMapper">

    <select id="findMyProfileByMemberId" resultType="com.yorimichi.yorimichi.domain.user.entity.User">
        SELECT
            member_id,
            email,
            name,
            phone
        FROM MEMBER
        WHERE member_id = #{memberId}
    </select>
    
    <update id="updateMyProfile">
    	UPDATE MEMBER
    	<set>
    		name = #{name},
    		phone = #{phone},
    		
    		<if test="encodedPassword != null">
    			password = #{encodedPassword},
    		</if>
    	</set>
    	WHERE member_id = #{memberId}
    </update>

</mapper>