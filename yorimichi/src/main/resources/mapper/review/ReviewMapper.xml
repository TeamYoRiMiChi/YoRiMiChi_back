<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yorimichi.yorimichi.domain.review.repository.ReviewMapper">

    <resultMap id="reviewResultMap" type="com.yorimichi.yorimichi.domain.review.entity.Review">
        <id     property="reviewId"    column="review_id"/>
        <result property="memberId"    column="member_id"/>
        <result property="productId"   column="product_id"/>
        <result property="saleType"    column="sale_type"/>
        <result property="orderItemId" column="order_item_id"/>
        <result property="rating"      column="rating"/>
        <result property="content"     column="content"/>
        <result property="createdAt"   column="created_at"/>
        <result property="updatedAt"   column="updated_at"/>
        <result property="memberName"  column="member_name"/>
    </resultMap>

    <resultMap id="targetResultMap" type="com.yorimichi.yorimichi.domain.review.entity.ReviewTarget">
        <id     property="orderItemId" column="order_item_id"/>
        <result property="orderId"     column="order_id"/>
        <result property="productId"   column="product_id"/>
        <result property="saleType"    column="sale_type"/>
        <result property="orderStatus" column="order_status"/>
    </resultMap>

    <resultMap id="ratingCountResultMap" type="com.yorimichi.yorimichi.domain.review.entity.ReviewRatingCount">
        <result property="rating" column="rating"/>
        <result property="count"  column="cnt"/>
    </resultMap>


    <!-- 내 주문 상품 한 건 — 다른 사람의 주문 상품에 쓰지 못하도록 member_id를 함께 확인합니다 -->
    <select id="findTarget" resultMap="targetResultMap">
        SELECT oi.order_item_id,
               oi.order_id,
               oi.product_id,
               oi.sale_type,
               o.order_status
        FROM ORDER_ITEM oi
        JOIN ORDERS o ON o.order_id = oi.order_id
        WHERE oi.order_item_id = #{orderItemId}
          AND o.member_id = #{memberId}
    </select>


    <select id="existsByOrderItemId" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM REVIEW
        WHERE order_item_id = #{orderItemId}
    </select>


    <insert id="insert"
            parameterType="com.yorimichi.yorimichi.domain.review.entity.Review"
            useGeneratedKeys="true" keyProperty="reviewId">
        INSERT INTO REVIEW (
            member_id, product_id, sale_type, order_item_id, rating, content
        ) VALUES (
            #{memberId}, #{productId}, #{saleType}, #{orderItemId}, #{rating}, #{content}
        )
    </insert>


    <!-- 상품의 리뷰 목록 (최신순) -->
    <select id="findByProductId" resultMap="reviewResultMap">
        SELECT r.review_id,
               r.member_id,
               r.product_id,
               r.sale_type,
               r.order_item_id,
               r.rating,
               r.content,
               r.created_at,
               r.updated_at,
               m.name AS member_name
        FROM REVIEW r
        LEFT JOIN MEMBER m ON m.member_id = r.member_id
        WHERE r.product_id = #{productId}
        ORDER BY r.created_at DESC, r.review_id DESC
        LIMIT #{limit}
    </select>


    <!-- 별점별 개수 -->
    <select id="countByRating" resultMap="ratingCountResultMap">
        SELECT rating, COUNT(*) AS cnt
        FROM REVIEW
        WHERE product_id = #{productId}
        GROUP BY rating
    </select>


    <!-- 내 주문 중 이미 리뷰를 쓴 주문 상품 -->
    <select id="findReviewedItemIdsByOrder" resultType="long">
        SELECT r.order_item_id
        FROM REVIEW r
        JOIN ORDER_ITEM oi ON oi.order_item_id = r.order_item_id
        JOIN ORDERS o ON o.order_id = oi.order_id
        WHERE oi.order_id = #{orderId}
          AND o.member_id = #{memberId}
        ORDER BY r.order_item_id
    </select>

</mapper>
