<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yorimichi.yorimichi.domain.product.repository.ProductMapper">

    <!-- DB 컬럼과 Product 엔티티 연결 -->
    <resultMap id="productResultMap"
               type="com.yorimichi.yorimichi.domain.product.entity.Product">

        <id property="productId" column="product_id"/>

        <result property="categoryId" column="category_id"/>
        <result property="saleType" column="sale_type"/>
        <result property="brand" column="brand"/>
        <result property="productName" column="product_name"/>
        <result property="productNameJp" column="product_name_jp"/>
        <result property="description" column="description"/>
        <result property="priceJpy" column="price_jpy"/>
        <result property="originalPriceJpy" column="original_price_jpy"/>
        <result property="stock" column="stock"/>
        <result property="salesCount" column="sales_count"/>
        <result property="weight" column="weight"/>
        <result property="originalUrl" column="original_url"/>
        <result property="thumbnailUrl" column="thumbnail_url"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>


    <!-- PRODUCT 공통 컬럼 -->
    <sql id="productColumns">
        product_id,
        category_id,
        sale_type,
        brand,
        product_name,
        product_name_jp,
        description,
        price_jpy,
        original_price_jpy,
        stock,
        sales_count,
        weight,
        original_url,
        thumbnail_url,
        status,
        created_at,
        updated_at
    </sql>


    <!-- 일반 상품 검색 조건 -->
    <sql id="searchConditions">
        <where>
            status = 'ACTIVE'

            <if test="saleType != null and saleType != ''">
                AND sale_type = #{saleType}
            </if>

            <if test="categoryId != null">
                AND category_id = #{categoryId}
            </if>

            <if test="keyword != null and keyword != ''">
                AND (
                    product_name LIKE CONCAT('%', #{keyword}, '%')
                    OR product_name_jp LIKE CONCAT('%', #{keyword}, '%')
                    OR brand LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
    </sql>


    <!-- 일반 상품 목록 -->
    <select id="findAll" resultMap="productResultMap">

        SELECT
            <include refid="productColumns"/>

        FROM PRODUCT

        <include refid="searchConditions"/>

        <choose>
            <when test="sort == 'popular'">
                ORDER BY sales_count DESC, product_id DESC
            </when>

            <when test="sort == 'newest'">
                ORDER BY created_at DESC, product_id DESC
            </when>

            <otherwise>
                ORDER BY product_id ASC
            </otherwise>
        </choose>

        LIMIT #{size} OFFSET #{offset}

    </select>


    <!-- 일반 상품 전체 개수 -->
    <select id="countAll" resultType="long">

        SELECT COUNT(*)

        FROM PRODUCT

        <include refid="searchConditions"/>

    </select>


    <!-- 상품별 가장 최근 공동구매 연결 -->
    <sql id="currentGroupBuyLeftJoin">

        LEFT JOIN GROUP_BUY gb
            ON gb.group_buy_id = (
                SELECT gb2.group_buy_id
                FROM GROUP_BUY gb2
                WHERE gb2.product_id = p.product_id
                ORDER BY gb2.group_buy_id DESC
                LIMIT 1
            )

    </sql>


   <!-- 공동구매 상품 검색 조건 -->
<sql id="groupBuySearchConditions">
    <where>
        p.sale_type = 'GROUP_BUY'
        AND p.status = 'ACTIVE'

        <choose>
            <when test="status == 'RECRUITING'">
                AND gb.status = 'RECRUITING'
            </when>

            <when test="status == 'CLOSING_SOON'">
                AND gb.status = 'RECRUITING'
                AND gb.end_date &gt; CURRENT_TIMESTAMP
                AND gb.end_date &lt;= DATE_ADD(
                    CURRENT_TIMESTAMP,
                    INTERVAL 3 DAY
                )
            </when>

            <when test="status == 'COMPLETED'">
                AND gb.status = 'SUCCESS'
            </when>

            <otherwise>
                AND gb.status IN ('RECRUITING', 'SUCCESS')
            </otherwise>
        </choose>

        <if test="categoryId != null">
            AND p.category_id = #{categoryId}
        </if>

        <if test="keyword != null and keyword != ''">
            AND (
                p.product_name LIKE CONCAT('%', #{keyword}, '%')
                OR p.product_name_jp LIKE CONCAT('%', #{keyword}, '%')
                OR p.brand LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
    </where>
</sql>

    <!-- 공동구매 상품 목록 -->
    <select id="findGroupBuyAll" resultMap="productResultMap">

        SELECT
            p.product_id,
            p.category_id,
            p.sale_type,
            p.brand,
            p.product_name,
            p.product_name_jp,
            p.description,
            p.price_jpy,
            p.original_price_jpy,
            p.stock,
            p.sales_count,
            p.weight,
            p.original_url,
            p.thumbnail_url,
            CASE
    WHEN gb.status = 'SUCCESS'
        THEN 'SUCCESS'

    WHEN gb.status = 'RECRUITING'
         AND gb.end_date &gt; CURRENT_TIMESTAMP
         AND gb.end_date &lt;= DATE_ADD(
             CURRENT_TIMESTAMP,
             INTERVAL 3 DAY
         )
        THEN 'CLOSING_SOON'

    WHEN gb.status = 'RECRUITING'
        THEN 'ACTIVE'

    ELSE gb.status
END AS status,
            p.created_at,
            p.updated_at

        FROM PRODUCT p

        <include refid="currentGroupBuyLeftJoin"/>

        <include refid="groupBuySearchConditions"/>

        <choose>
            <when test="sort == 'popular'">
                ORDER BY p.sales_count DESC, p.product_id DESC
            </when>

            <when test="sort == 'newest'">
                ORDER BY
                    COALESCE(gb.created_at, p.created_at) DESC,
                    p.product_id DESC
            </when>

            <when test="sort == 'priceAsc'">
                ORDER BY p.price_jpy ASC, p.product_id DESC
            </when>

            <otherwise>
                ORDER BY p.product_id ASC
            </otherwise>
        </choose>

        LIMIT #{size} OFFSET #{offset}

    </select>


    <!-- 공동구매 상품 전체 개수 -->
    <select id="countGroupBuyAll" resultType="long">

        SELECT COUNT(*)

        FROM PRODUCT p

        <include refid="currentGroupBuyLeftJoin"/>

        <include refid="groupBuySearchConditions"/>

    </select>


    <!-- 상품 단건 조회 -->
    <select id="findById" resultMap="productResultMap">

        SELECT
            <include refid="productColumns"/>

        FROM PRODUCT

        WHERE product_id = #{productId}

    </select>

</mapper>