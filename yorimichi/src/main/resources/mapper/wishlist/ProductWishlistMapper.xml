<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yorimichi.yorimichi.domain.wishlist.repository.ProductWishlistMapper">

    <resultMap id="productWishlistResultMap"
               type="com.yorimichi.yorimichi.domain.wishlist.entity.ProductWishlist">
        <id     property="wishlistId"       column="wishlist_id"/>
        <result property="memberId"         column="member_id"/>
        <result property="productId"        column="product_id"/>
        <result property="groupBuyId"       column="group_buy_id"/>
        <result property="createdAt"        column="created_at"/>

        <!-- PRODUCT 조인 값 -->
        <result property="brand"            column="brand"/>
        <result property="productName"      column="product_name"/>
        <result property="priceJpy"         column="price_jpy"/>
        <result property="originalPriceJpy" column="original_price_jpy"/>
        <result property="thumbnailUrl"     column="thumbnail_url"/>
        <result property="stock"            column="stock"/>
        <result property="productStatus"    column="product_status"/>
    </resultMap>


    <!-- 찜 목록 (상품 정보 함께) -->
    <select id="findByMemberId" resultMap="productWishlistResultMap">
        SELECT
            w.wishlist_id,
            w.member_id,
            w.product_id,
            (
                SELECT gb.group_buy_id
                FROM GROUP_BUY gb
                WHERE gb.product_id = w.product_id
                ORDER BY gb.group_buy_id DESC
                LIMIT 1
            ) AS group_buy_id,
            w.created_at,
            p.brand,
            p.product_name,
            p.price_jpy,
            p.original_price_jpy,
            p.thumbnail_url,
            p.stock,
            p.status AS product_status
        FROM WISHLIST w
        JOIN PRODUCT p ON p.product_id = w.product_id
        WHERE w.member_id = #{memberId}
        ORDER BY w.created_at DESC, w.wishlist_id DESC
    </select>


    <!--
      상품 id만 뽑습니다.
      상품 목록 화면에서 "어떤 상품이 찜 상태인지"만 알면 되는 경우에 씁니다.
      조인이 없어서 가볍습니다.
    -->
    <select id="findProductIdsByMemberId" resultType="long">
        SELECT product_id
        FROM WISHLIST
        WHERE member_id = #{memberId}
    </select>


    <select id="exists" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM WISHLIST
        WHERE member_id = #{memberId}
          AND product_id = #{productId}
    </select>


    <insert id="insert">
        INSERT INTO WISHLIST (member_id, product_id)
        VALUES (#{memberId}, #{productId})
    </insert>


    <delete id="delete">
        DELETE FROM WISHLIST
        WHERE member_id = #{memberId}
          AND product_id = #{productId}
    </delete>

</mapper>
