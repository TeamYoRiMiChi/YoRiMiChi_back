<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yorimichi.yorimichi.domain.inquiry.repository.InquiryMapper">

    <insert id="insert"
            parameterType="com.yorimichi.yorimichi.domain.inquiry.entity.Inquiry"
            useGeneratedKeys="true"
            keyProperty="inquiryId">
        INSERT INTO INQUIRY (
            member_id,
            category,
            title,
            content,
            status
        ) VALUES (
            #{memberId},
            #{category},
            #{title},
            #{content},
            #{status}
        )
    </insert>

</mapper>
